#!/bin/bash
#PBS -N extract_timbre
#PBS -l select=1:ncpus=4:mem=32gb:host=node03
#PBS -l walltime=04:00:00
#PBS -q workq
#PBS -o /home/n_harini/voicegen/logs/extract_timbre.out
#PBS -e /home/n_harini/voicegen/logs/extract_timbre.err

# ============================================================
# ECAPA-TDNN Timbre Embedding Extraction Job
# ============================================================
# This script extracts speaker embeddings from audio files using
# the pretrained ECAPA-TDNN model from SpeechBrain.
#
# Usage:
#   qsub extract_timbre.pbs
#
# Prerequisites:
#   - speechbrain installed: pip install speechbrain
#   - Prosody features already extracted (filelists/*.prosody exist)
# ============================================================

echo "============================================================"
echo "Job Started: $(date)"
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"
echo "============================================================"

# Change to project directory
cd $PBS_O_WORKDIR

# Create log directory
mkdir -p logs

# Load CUDA
echo "Loading CUDA module..."
module load cuda11.6/toolkit/11.6.2

# Activate micromamba environment
echo "Activating voicegen environment..."
eval "$(micromamba shell hook --shell bash)"
micromamba activate voicegen

echo ""
echo "Environment Information"
echo "-----------------------"
which python
python --version
echo "PyTorch: $(python -c 'import torch; print(torch.__version__)')"
echo "CUDA Available: $(python -c 'import torch; print(torch.cuda.is_available())')"
if python -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU: $(python -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi

echo ""
echo "Checking speechbrain installation..."
# SpeechBrain 0.5.x uses speechbrain.pretrained (not speechbrain.inference)
python -c "from speechbrain.pretrained import EncoderClassifier; print('speechbrain OK')" || {
    echo "ERROR: speechbrain not available or incompatible version."
    echo "Expected: speechbrain 0.5.x with speechbrain.pretrained module"
    exit 1
}

echo ""
echo "============================================================"
echo "Starting ECAPA-TDNN Timbre Extraction for VCTK..."
echo "============================================================"

# Extract timbre embeddings for VCTK
# Adjust paths based on your data structure
python extract_timbre_embeddings.py \
    --filelist filelists/vctk_audio_sid_text_train.txt.prosody \
    --filelist filelists/vctk_audio_sid_text_val.txt.prosody \
    --output_dir data/processed/vctk/timbre \
    --device cuda

echo ""
echo "============================================================"
echo "Verifying extraction..."
echo "============================================================"

# Count extracted files
TIMBRE_COUNT=$(find data/processed/vctk/timbre -name "*.npy" 2>/dev/null | wc -l)
echo "Total timbre embeddings extracted: $TIMBRE_COUNT"

# Verify a sample
python -c "
import numpy as np
import glob

files = glob.glob('data/processed/vctk/timbre/**/*.npy', recursive=True)
if files:
    sample = np.load(files[0])
    print(f'Sample embedding shape: {sample.shape}')
    print(f'Sample stats: min={sample.min():.4f}, max={sample.max():.4f}, mean={sample.mean():.4f}')
else:
    print('WARNING: No embedding files found!')
"

echo ""
echo "============================================================"
echo "Job Finished: $(date)"
echo "============================================================"
