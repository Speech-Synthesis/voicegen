#!/bin/bash
#PBS -N stability_test
#PBS -l select=1:ncpus=4:mem=32gb:host=node03
#PBS -l walltime=01:00:00
#PBS -q workq
#PBS -o /home/n_harini/voicegen/logs/stability_test.out
#PBS -e /home/n_harini/voicegen/logs/stability_test.err

# ============================================================
# VITS Numerical Stability Test (100 steps)
# ============================================================
# Tests stability fixes by running 100 training steps with
# real VCTK data. Verifies:
#   - No NaN/Inf values in activations or gradients
#   - Gradient norms stay bounded
#   - All 100 steps complete successfully
# ============================================================

echo "============================================================"
echo "VITS Stability Test - 100 Steps"
echo "============================================================"
echo "Job Started: $(date)"
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"
echo "============================================================"

cd $PBS_O_WORKDIR
mkdir -p logs
mkdir -p checkpoints/stability_test

# Load CUDA
module load cuda11.6/toolkit/11.6.2

# Activate environment
eval "$(micromamba shell hook --shell bash)"
micromamba activate voicegen

echo ""
echo "Environment:"
which python
python --version
echo "PyTorch: $(python -c 'import torch; print(torch.__version__)')"
echo "CUDA Available: $(python -c 'import torch; print(torch.cuda.is_available())')"
if python -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU: $(python -c 'import torch; print(torch.cuda.get_device_name(0))')"
else
    echo "GPU: N/A (CPU mode)"
fi

# Verify stability fixes are present
echo ""
echo "Verifying stability fixes..."
python -c "
from models import PosteriorEncoder, TextEncoder
from prosody_encoder import ProsodyEncoder
import torch

# Check PosteriorEncoder has zero-initialized logs
enc = PosteriorEncoder(513, 192, 192, 5, 1, 16, gin_channels=192)
logs_weight = enc.proj.weight.data[192:, :, :]
logs_bias = enc.proj.bias.data[192:]
assert torch.allclose(logs_weight, torch.zeros_like(logs_weight)), 'PosteriorEncoder logs not zero-initialized!'
assert torch.allclose(logs_bias, torch.zeros_like(logs_bias)), 'PosteriorEncoder logs bias not zero-initialized!'
print('PosteriorEncoder: logs zero-initialized OK')

# Check TextEncoder has zero-initialized logs
tenc = TextEncoder(200, 192, 192, 768, 2, 6, 3, 0.1)
logs_weight_t = tenc.proj.weight.data[192:, :, :]
logs_bias_t = tenc.proj.bias.data[192:]
assert torch.allclose(logs_weight_t, torch.zeros_like(logs_weight_t)), 'TextEncoder logs not zero-initialized!'
assert torch.allclose(logs_bias_t, torch.zeros_like(logs_bias_t)), 'TextEncoder logs bias not zero-initialized!'
print('TextEncoder: logs zero-initialized OK')

# Check ProsodyEncoder has small weight initialization
penc = ProsodyEncoder()
inp_weight_norm = penc.inp.weight.data.norm().item()
print(f'ProsodyEncoder: inp weight norm = {inp_weight_norm:.4f} (should be small)')
assert inp_weight_norm < 1.0, 'ProsodyEncoder inp weights too large!'

# Check that input LayerNorm exists
assert hasattr(penc, 'input_ln'), 'ProsodyEncoder missing input_ln!'
print('ProsodyEncoder: input LayerNorm present')

print('All stability fixes verified!')
"

if [ $? -ne 0 ]; then
    echo "ERROR: Stability fixes not properly applied!"
    exit 1
fi

echo ""
echo "============================================================"
echo "Starting 100-step training test..."
echo "============================================================"
START_TIME=$(date +%s)

python train_full.py \
    --config configs/vctk_stability_test.json \
    --model_dir checkpoints/stability_test

EXIT_CODE=$?
END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo ""
echo "============================================================"
echo "Test Results"
echo "============================================================"
echo "Exit code: $EXIT_CODE"
echo "Elapsed time: ${ELAPSED}s"

if [ $EXIT_CODE -eq 0 ]; then
    echo "STATUS: Training script completed"
else
    echo "STATUS: Training script crashed"
fi

# Check for FIRST NON-FINITE detection
echo ""
echo "Checking for non-finite values..."
if grep -q "FIRST NON-FINITE" logs/stability_test.out 2>/dev/null; then
    echo "FAILURE: Non-finite values detected!"
    echo ""
    grep -A 15 "FIRST NON-FINITE" logs/stability_test.out | head -20
fi

# Check for NaN in activations
if grep -q "\[NaN\]" logs/stability_test.out 2>/dev/null; then
    echo ""
    echo "NaN in activations:"
    grep "\[NaN\]" logs/stability_test.out | head -5
fi

# Check for Inf in activations
if grep -q "\[Inf\]" logs/stability_test.out 2>/dev/null; then
    echo ""
    echo "Inf in activations:"
    grep "\[Inf\]" logs/stability_test.out | head -5
fi

# Show gradient norms progression
echo ""
echo "Gradient norm samples (first 10 steps):"
grep "total_norm_before_clip" logs/stability_test.out | head -10

# Check for any skipped steps
echo ""
echo "Skipped steps (due to non-finite gradients):"
SKIPPED=$(grep -c "Skipping optimizer step" logs/stability_test.out 2>/dev/null || echo "0")
echo "Count: $SKIPPED"
if [ "$SKIPPED" != "0" ]; then
    grep "Skipping optimizer step" logs/stability_test.out | head -5
fi

# Show final statistics
echo ""
echo "Final training statistics (last 5 steps):"
grep "\[Stats\]" logs/stability_test.out | tail -15

echo ""
echo "Loss summary (last 10 log entries):"
grep "Loss Total" logs/stability_test.out | tail -10

# Final verdict
echo ""
echo "============================================================"
if grep -q "SUCCESS: No NaN/Inf values detected" logs/stability_test.out 2>/dev/null; then
    if [ "$SKIPPED" = "0" ]; then
        echo "RESULT: PASSED - Training completed 100 steps without NaN/Inf"
    else
        echo "RESULT: PARTIAL - Completed but had $SKIPPED skipped steps"
    fi
elif grep -q "WARNING: Training encountered NaN/Inf" logs/stability_test.out 2>/dev/null; then
    echo "RESULT: FAILED - Training encountered NaN/Inf values"
elif grep -q "FIRST NON-FINITE" logs/stability_test.out 2>/dev/null; then
    echo "RESULT: FAILED - Non-finite values detected"
else
    echo "RESULT: UNKNOWN - Check logs manually"
fi
echo "============================================================"

echo ""
echo "Job Finished: $(date)"

exit $EXIT_CODE
